# Written automatically by `npx convex dev` into .env.local (gitignored) once
# you link this repo to a Convex deployment — you don't need to set these by hand.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Set server-side only, via the Convex CLI (never put this in .env.local):
#   npx convex env set ANTHROPIC_API_KEY sk-...
# Documented here so the full set of required configuration is visible in one place.
# ANTHROPIC_API_KEY=
